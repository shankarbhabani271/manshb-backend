# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (replace with your MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/urbasi?retryWrites=true&w=majority

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_token_secret_key_make_it_very_long_and_secure_123456
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_make_it_very_long_and_secure_123456
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Transporter (SMTP) Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Urbasi Backend" <noreply@urbasi.com>

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Super Admin Seeding Credentials
SUPER_ADMIN_NAME="Super Admin Name"
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password_12345
